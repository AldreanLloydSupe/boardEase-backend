rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    match /applications/{applicationId} {
      allow create: if request.auth != null
        && request.resource.data.tenantId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.tenantId == request.auth.uid || request.auth.token.admin == true);
      allow update, delete: if request.auth != null
        && request.auth.token.admin == true;
    }

    match /tourRequests/{tourRequestId} {
      allow create: if request.auth != null
        && request.resource.data.tenantId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.tenantId == request.auth.uid || request.auth.token.admin == true);
      allow update: if request.auth != null
        && (
          request.auth.token.admin == true
          || (
            resource.data.tenantId == request.auth.uid
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'cancelled'
          )
        );
      allow delete: if request.auth != null
        && request.auth.token.admin == true;
    }

    match /payments/{paymentId} {
      allow create: if request.auth != null
        && request.resource.data.tenantId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.tenantId == request.auth.uid || request.auth.token.admin == true);
      allow update: if request.auth != null
        && request.auth.token.admin == true;
      allow delete: if request.auth != null
        && request.auth.token.admin == true;
    }

    match /maintenanceRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.tenantId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.tenantId == request.auth.uid || request.auth.token.admin == true);
      allow update, delete: if request.auth != null
        && (request.auth.token.admin == true || resource.data.tenantId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
