uest.auth.uid;\n      allow read: if request.auth != null\n        && (resource.data.tenantId == request.auth.uid || request.auth.token.admin == true);\n      allow update: if request.auth != null\n        && request.auth.token.admin == true;\n      allow delete: if request.auth != null\n        && request.auth.token.admin == true;\n    }\n\n    match /maintenanceRequests/{requestId} {\n      allow create: if request.auth != null\n        && request.resource.data.tenantId == request.auth.uid;\n      allow read: if request.auth != null\n        && (resource.data.tenantId == request.auth.uid || request.auth.token.admin == true);\n      allow update, delete: if request.auth != null\n        && (request.auth.token.admin == true || resource.data.tenantId == request.auth.uid);\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-20T08:38:56.199391Z","metadata":{"services":["cloud.firestore"]}}
