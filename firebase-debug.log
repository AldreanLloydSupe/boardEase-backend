uest.auth.uid;\n      allow read: if request.auth != null\n        && (resource.data.tenantId == request.auth.uid || request.auth.token.admin == true);\n      allow update: if request.auth != null\n        && request.auth.token.admin == true;\n      allow delete: if request.auth != null\n        && request.auth.token.admin == true;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-20T08:21:23.759327Z","metadata":{"services":["cloud.firestore"]}}
